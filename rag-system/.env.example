# ---------- LLM (OpenAI-совместимый endpoint) ----------
# mock   — детерминированная заглушка, без сети и ключей (по умолчанию, если ключ не задан)
# openai — реальный OpenAI-совместимый провайдер (OpenRouter, Ollama, vLLM, OpenAI)
# auto   — openai, если задан LLM_API_KEY или endpoint локальный; иначе mock
LLM_PROVIDER=auto
# OpenRouter (по умолчанию). Для Ollama: http://localhost:11434/v1 (ключ любой, например "ollama")
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-8b

# ---------- Эмбеддинги ----------
# auto — fastembed, если установлен extra `local` (uv sync --extra local), иначе hashing
# fastembed — ONNX-модель (EMBED_MODEL), hashing — детерминированный numpy-хешинг (для тестов/демо)
EMBEDDER=auto
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Для русских документов лучше мультиязычная модель, например:
# EMBED_MODEL=intfloat/multilingual-e5-small

# ---------- Реранкер ----------
# auto — cross-encoder fastembed, если установлен, иначе лексический; lexical | fastembed | none
RERANKER=auto
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---------- Хранилище ----------
# memory — numpy in-memory + сохранение в RAG_INDEX_DIR; pgvector — Postgres + pgvector
RAG_STORE=memory
RAG_INDEX_DIR=.rag_index
# DSN для docker-compose.yml из этой папки. Также включает интеграционный pgvector-тест.
PG_DSN=postgresql://rag:rag@localhost:5432/rag
# hnsw | ivfflat
PG_INDEX=hnsw

# Сколько фрагментов отдавать в контекст LLM
RAG_TOP_K=4
