# OpenAI-совместимый endpoint. По умолчанию OpenRouter.
# Для локальной Ollama: LLM_BASE_URL=http://localhost:11434/v1 (ключ можно не задавать)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Ключ провайдера. Если ключ не задан и endpoint не локальный — используется MockLLM.
LLM_API_KEY=

# Модель для переписывания резюме, сопроводительных писем и извлечения вакансий
LLM_MODEL=qwen/qwen3-8b

# Принудительно включить детерминированную заглушку (1/true) — удобно для демо и CI
LLM_MOCK=0
