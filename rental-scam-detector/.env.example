# Все переменные необязательны: по умолчанию пути считаются от корня проекта.

# Путь к обученной модели CatBoost (создаётся `uv run scam train`)
SCAM_MODEL_PATH=models/scam.cbm

# Справочник медианных цен аренды $/м²/мес по районам Ташкента
SCAM_DISTRICTS_CSV=data/district_prices.csv

# Папка с JSON-объявлениями — корпус для поиска дубликатов фото/текста и повторных телефонов (API)
SCAM_CORPUS_DIR=data/samples

# Курс для перевода цен в UZS в доллары
SCAM_UZS_PER_USD=12700

# Порог близости перцептивных хэшей (бит из 64): max(pHash, dHash) <= порога → дубликат
SCAM_PHOTO_THRESHOLD=10

# LLM в проекте не используется (всё на правилах + CatBoost), ключи не нужны.
