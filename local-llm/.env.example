# --- Единый OpenAI-совместимый клиент (см. CONVENTIONS.md) ---
# Ollama:  http://localhost:11434/v1
# vLLM:    http://localhost:8000/v1
# Облако:  https://openrouter.ai/api/v1 (значение по умолчанию)
LLM_BASE_URL=http://localhost:11434/v1
# Для Ollama/vLLM ключ не проверяется, подойдёт любая строка
LLM_API_KEY=local
# Имя модели в формате бэкенда: тег Ollama или served-model-name vLLM
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
# 1 = использовать детерминированный MockLLM вместо сети
LLM_MOCK=0

# --- Нативный API Ollama (/api/tags, /api/pull, /api/show) ---
OLLAMA_HOST=http://localhost:11434

# --- Каталог пресетов (по умолчанию ./presets) ---
# LOCAL_LLM_PRESETS_DIR=./presets

# --- Для docker-compose: скачивание gated-моделей (Llama) с Hugging Face ---
# HUGGING_FACE_HUB_TOKEN=hf_xxx
