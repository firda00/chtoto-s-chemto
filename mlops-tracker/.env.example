# OpenAI-совместимый endpoint (OpenRouter по умолчанию; для Ollama: http://localhost:11434/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ключ API. Если пусто — везде используется детерминированный MockLLM
LLM_API_KEY=
# Модель для LLM-judge и примера агента
LLM_MODEL=qwen/qwen3-8b
# Принудительно включить заглушку даже при наличии ключа: mock | openai | auto
LLM_PROVIDER=auto
# Путь к SQLite-базе трекера (по умолчанию ./mlruns/mlt.db)
MLT_DB=mlruns/mlt.db
# 1 — не вызывать git при старте рана (git-коммит в снапшот не попадёт)
MLT_DISABLE_GIT=0
