# --- Движок -----------------------------------------------------------------
# Путь к бинарнику Stockfish (если не задан — ищется `stockfish` / `stockfish.exe` в PATH).
# Windows пример: C:\tools\stockfish\stockfish-windows-x86-64-avx2.exe
# Linux пример:   /usr/games/stockfish
STOCKFISH_PATH=

# URL удалённого «Stockfish API» (режим --engine api), формат как у stockfish.online v2:
# GET <url>?fen=<FEN>&depth=<N>  ->  {"success", "evaluation", "mate", "bestmove", "continuation"}
STOCKFISH_API_URL=https://stockfish.online/api/s/v2.php

# --- LLM (объяснения ошибок) -------------------------------------------------
# Любой OpenAI-совместимый endpoint. Для Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ключ. Если пуст — `--llm auto` использует шаблонные объяснения без LLM.
LLM_API_KEY=
# Модель (для Ollama, например, qwen3:8b)
LLM_MODEL=qwen/qwen3-8b
