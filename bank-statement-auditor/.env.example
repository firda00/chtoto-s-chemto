# LLM нужен ТОЛЬКО для необязательной категоризации неизвестных мерчантов (флаг --llm).
# Без ключа всё работает на правилах; тесты используют MockLLM и в сеть не ходят.

# OpenAI-совместимый endpoint (OpenRouter по умолчанию; для Ollama: http://localhost:11434/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ключ провайдера (для Ollama можно любой непустой, например "ollama")
LLM_API_KEY=
# Модель
LLM_MODEL=qwen/qwen3-8b
